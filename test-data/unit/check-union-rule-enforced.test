[case testUnionRuleCoversMethods]
# flags: --python-version 3.11 --config-file tmp/mypy.ini --show-error-codes

class Parser:
    def parse(self, value: int | str) -> int | str:  # E: Union return types are not allowed  [union-return]
        return value


Parser().parse(1)
Parser().parse("hello")


