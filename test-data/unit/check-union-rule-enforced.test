[case testUnionRuleReportsOnceAtDefinition]
# flags: --python-version 3.11 --config-file tmp/mypy.ini --show-error-codes

def choose(value: int | str) -> int | str:  # E: Union return types are not allowed  [union-return]
    return value


def first_caller() -> None:
    choose(1)


def second_caller() -> None:
    choose("hello")


[file mypy.ini]
