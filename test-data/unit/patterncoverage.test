[case testPatternCoverageMissingEnumAndFlags]
from enum import Enum, Flag, IntFlag
class E(Enum):
    A = 1
    B = 2
    C = 3
class F(Flag):
    A = 1
    B = 2
class I(IntFlag):
    A = 1
    B = 2

def missing(x: tuple[E, E, E, E]) -> int: # E: Missing return statement
    match x:
        case E.A, E.A, _, _: return 1
        case _, _, E.A, E.A: return 1
        case _, _, E.B, _: return 0
        case _, _, _, E.B: return 0

def flags(x: tuple[F, F, F, F]) -> int: # E: Missing return statement
    match x:
        case F.A, F.A, _, _: return 1
        case _, _, F.A, F.A: return 1
        case _, _, F.B, _: return 0
        case _, _, _, F.B: return 0

def intflags(x: tuple[I, I, I, I]) -> int: # E: Missing return statement
    match x:
        case I.A, I.A, _, _: return 1
        case _, _, I.A, I.A: return 1
        case _, _, I.B, _: return 0
        case _, _, _, I.B: return 0
[builtins fixtures/tuple.pyi]

[case testPatternCoverageLiterals]
# flags: --enable-error-code exhaustive-match
from typing import Literal

def integers(x: tuple[Literal[-1, 1], Literal[-1, 1], Literal[-1, 1], Literal[-1, 1]]) -> int:
    match x:
        case -1, -1, _, _: return 1
        case _, _, -1, -1: return 1
        case _, _, 1, _: return 0
        case _, _, _, 1: return 0

def strings(x: tuple[Literal["a", "b"], Literal["a", "b"], Literal[b"a", b"b"], Literal[b"a", b"b"]]) -> int:
    match x:
        case "a", "a", _, _: return 1
        case _, _, b"a", b"a": return 1
        case _, _, b"b", _: return 0
        case _, _, _, b"b": return 0
[builtins fixtures/tuple.pyi]

[case testPatternCoverageOpaqueAndDistinctAtoms]
from typing import Any, Literal

def dynamic(x: tuple[Any, Any, Any, Any]) -> int: # E: Missing return statement
