[case testPatternCoverageNestedAndOr]
# flags: --enable-error-code exhaustive-match
def nested(x: tuple[tuple[bool, bool], tuple[bool, bool]]) -> int:
    match x:
        case (True, True), _: return 1
        case _, (True, True): return 1
        case _, (False, _): return 0
        case _, (_, False): return 0

def alternatives(x: tuple[bool, bool, bool, bool]) -> int:
    match x:
        case True, True, _, _: return 1
        case _, _, True, True: return 1
        case (_, _, False, _) | (_, _, _, False): return 0

def captured(x: tuple[bool, bool, bool, bool]) -> int:
    match x:
        case True, True, _, _: return 1
        case _, _, True, True: return 1
        case (_, _, False as flag, _) | (_, _, _, False as flag):
            reveal_type(flag) # N: Revealed type is "Literal[False]"
            return 0
[builtins fixtures/tuple.pyi]

[case testPatternCoverageNestedMissing]
def f(x: tuple[tuple[bool, bool], tuple[bool, bool]]) -> int: # E: Missing return statement
    match x:
