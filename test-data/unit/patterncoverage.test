        case _, _, True, True: return 1
        case _, _, False, _: return 0
        case _, _, _, False: return 0

def integers(x: tuple[Literal[0, 1], Literal[0, 1], Literal[0, 1], Literal[0, 1]]) -> int: # E: Missing return statement
    match x:
        case True, True, _, _: return 1
        case _, _, True, True: return 1
        case _, _, False, _: return 0
        case _, _, _, False: return 0
