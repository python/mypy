[case testPatternCoverageSingleMemberFlags]
from enum import Flag, IntFlag
F = Flag('F', 'A')
class I(IntFlag):
    A = 1

# Zero remains possible even when there is only one named flag.
def flags(x: tuple[F, bool]) -> int: # E: Missing return statement
    match x:
        case F.A, _: return 1

def intflags(x: tuple[I, bool]) -> int: # E: Missing return statement
    match x:
        case I.A, _: return 1

def identity(x: F) -> None:
    if x is F.A:
        reveal_type(x) # N: Revealed type is "Literal[__main__.F.A]"
    else:
        reveal_type(x) # N: Revealed type is "__main__.F"
[builtins fixtures/tuple.pyi]

[case testPatternCoverageFlagLiteralUnion]
# flags: --enable-error-code exhaustive-match
from enum import Flag
from typing import Literal
class F(Flag):
    A = 1
    B = 2

# Explicit literal unions exclude unnamed combinations and can be exhaustive.
def flags(x: tuple[Literal[F.A, F.B], bool]) -> int:
    match x:
        case F.A, _: return 1
        case F.B, _: return 0

def alternatives(x: F) -> None:
    match x:
        case F.A | F.B:
            reveal_type(x) # N: Revealed type is "Literal[__main__.F.A] | Literal[__main__.F.B]"
        case _:
            reveal_type(x) # N: Revealed type is "__main__.F"
[builtins fixtures/tuple.pyi]
