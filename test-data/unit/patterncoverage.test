-- Checker regressions use a narrowing limit of 2 and the production coverage budget.

[case testPatternCoverageReturnAndAssignment]
# flags: --enable-error-code exhaustive-match
def returning(x: tuple[bool, bool, bool, bool]) -> int:
    match x:
        case True, True, _, _: return 1
        case _, _, True, True: return 1
        case _, _, False, _: return 0
        case _, _, _, False: return 0

def assigned(x: tuple[bool, bool, bool, bool]) -> int:
    match x:
        case True, True, _, _: result = 1
        case _, _, True, True: result = 1
        case _, _, False, _: result = 0
        case _, _, _, False: result = 0
    return result
[builtins fixtures/tuple.pyi]

[case testPatternCoverageBodyErrors]
# flags: --enable-error-code exhaustive-match
def fallthrough(x: tuple[bool, bool, bool, bool]) -> int: # E: Missing return statement
    match x:
        case True, True, _, _: pass
        case _, _, True, True: pass
        case _, _, False, _: pass
        case _, _, _, False: pass

def wrong_return(x: tuple[bool, bool, bool, bool]) -> int:
    match x:
        case True, True, _, _: return "wrong" # E: Incompatible return value type (got "str", expected "int")
        case _, _, True, True: return 1
        case _, _, False, _: return 0
        case _, _, _, False: return 0
[builtins fixtures/tuple.pyi]

[case testPatternCoverageIncompleteAndGuarded]
def missing(x: tuple[bool, bool, bool, bool]) -> int: # E: Missing return statement
    match x:
        case True, True, _, _: return 1
        case _, _, True, True: return 1
        case _, _, False, _: return 0

def guarded(x: tuple[bool, bool, bool, bool], guard: bool) -> int: # E: Missing return statement
    match x:
        case True, True, _, _: return 1
        case _, _, True, True: return 1
        case _, _, False, _: return 0
        case _, _, _, False if guard: return 0

# A true guard disables coverage without changing the remainder. This fails only
# with the lowered narrowing budget, verifying that the suite reaches the fallback.
def narrowing_only(x: tuple[bool, bool, bool, bool]) -> int: # E: Missing return statement
    match x:
        case True, True, _, _: return 1
        case _, _, True, True: return 1
        case _, _, False, _: return 0
        case _, _, _, False if True: return 0
[builtins fixtures/tuple.pyi]

[case testPatternCoverageNominalClasses]
# flags: --enable-error-code exhaustive-match
from typing import Generic, TypeVar
T = TypeVar('T')
class A(Generic[T]): pass
class B(Generic[T]): pass
class Both(A[int], B[int]): pass

def f(x: tuple[A[int] | B[int], A[int] | B[int], A[int] | B[int], A[int] | B[int]]) -> int:
    match x:
        case A(), A(), _, _: return 1
        case _, _, A(), A(): return 1
        case _, _, B(), _: return 0
        case _, _, _, B(): return 0
[builtins fixtures/tuple.pyi]

[case testPatternCoverageEnums]
