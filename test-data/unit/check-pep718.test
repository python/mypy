main:4: error: Argument 1 has incompatible type "str"; expected "int"


[case testPEP718DecoratorPreservesDeclarationOrder]
# flags: --enable-incomplete-feature=SubscriptableFunctions --python-version=3.16
from typing import Callable
class Box[T]: ...
def decorate[**P, R](f: Callable[P, list[R]]) -> Callable[P, Box[R]]: ...
@decorate
def factory[T, U](arg: U) -> list[T]: ...
reveal_type(factory[int, str])  # N: Revealed type is "def (arg: builtins.str) -> __main__.Box[builtins.int]"
[builtins fixtures/list.pyi]

[case testPEP718ReturnOnlyBoundAndConstraint]
# flags: --enable-incomplete-feature=SubscriptableFunctions --python-version=3.16
def bounded[T: str]() -> T: ...
def constrained[T: (str, int)]() -> T: ...
bounded()  # E: Cannot infer value of type parameter "T" of "bounded"
constrained()  # E: Cannot infer value of type parameter "T" of "constrained"
reveal_type(bounded[str]())  # N: Revealed type is "builtins.str"
reveal_type(constrained[int]())  # N: Revealed type is "builtins.int"
[builtins fixtures/tuple.pyi]

[case testPEP718AliasResubscriptionClassInference]
# flags: --enable-incomplete-feature=SubscriptableFunctions --python-version=3.16
class C[T]:
    @classmethod
    def cm[U](cls, x: T, y: U) -> tuple[T, U]: ...
def use[U]() -> None:
    alias = C.cm[U]
    reveal_type(alias[int](0, 1))  # N: Revealed type is "tuple[builtins.int, builtins.int]"
[builtins fixtures/classmethod.pyi]
