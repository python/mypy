A = NamedTuple('A', [('y', int)])
B = NamedTuple('B', [('x', int)])
C = NamedTuple('C', [('x', int)])

def foo(a: Union[A, B, C]):
    if isinstance(a, (B, C)):
        reveal_type(a) # N: Revealed type is "tuple[builtins.int, fallback=__main__.B] | tuple[builtins.int, fallback=__main__.C]"
        a.x
        a.y # E: Item "B" of "B | C" has no attribute "y" \
            # E: Item "C" of "B | C" has no attribute "y"
        b = a # type: Union[B, C]
