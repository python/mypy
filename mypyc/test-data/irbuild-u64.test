# Test cases for u64 native ints. Focus on things that are different from u8; no need to
# duplicate all u8 test cases here.

[case testU64BinaryOp]
from mypy_extensions import u64

def add_op(x: u64, y: u64) -> u64:
    x = y + x
    y = x + 5
    y += x
    y += 7
    x = 5 + y
    return x
def compare(x: u64, y: u64) -> None:
    a = x == y
    b = x == 5
    c = x < y
    d = x < 5
    e = 5 == x
    f = 5 < x
[out]
def add_op(x, y):
    x, y, r0, r1, r2, r3, r4 :: u64
L0:
    r0 = y + x
    x = r0
    r1 = x + 5
    y = r1
    r2 = y + x
    y = r2
    r3 = y + 7
    y = r3
    r4 = 5 + y
    x = r4
    return x
def compare(x, y):
    x, y :: u64
    r0 :: bit
    a :: bool
    r1 :: bit
    b :: bool
    r2 :: bit
    c :: bool
    r3 :: bit
    d :: bool
    r4 :: bit
    e :: bool
    r5 :: bit
    f :: bool
L0:
    r0 = x == y
    a = r0
    r1 = x == 5
    b = r1
    r2 = x < y :: unsigned
    c = r2
    r3 = x < 5 :: unsigned
    d = r3
    r4 = 5 == x
    e = r4
    r5 = 5 < x :: unsigned
    f = r5
    return 1

[case testU64DetectMoreOutOfRangeLiterals]
from mypy_extensions import u64

def out_of_range() -> None:
    a: u64 = 18446744073709551616
    b: u64 = -1
    f(18446744073709551616)
    # The following are ok
    c: u64 = 0
    d: u64 = 18446744073709551615
    f(0)
    f(18446744073709551615)

def f(x: u64) -> None: pass
[out]
main:4: error: Value 18446744073709551616 is out of range for "u64"
main:5: error: Value -1 is out of range for "u64"
main:6: error: Value 18446744073709551616 is out of range for "u64"

[case testU64BoxAndUnbox]
from typing import Any
from mypy_extensions import u64

def f(x: Any) -> Any:
    y: u64 = x
    return y
[out]
def f(x):
    x :: object
    r0, y :: u64
    r1 :: object
L0:
    r0 = unbox(u64, x)
    y = r0
    r1 = box(u64, y)
    return r1

[case testU64ConvertToInt_64bit]
from mypy_extensions import u64

def u64_to_int(a: u64) -> int:
    return a
[out]
def u64_to_int(a):
    a :: u64
    r0 :: bit
    r1, r2, r3 :: int
L0:
    r0 = a <= 4611686018427387903 :: unsigned
    if r0 goto L2 else goto L1 :: bool
L1:
    r1 = CPyTagged_FromUInt64(a)
    r2 = r1
    goto L3
L2:
    r3 = a << 1
    r2 = r3
L3:
    return r2

[case testU64ExplicitConversionFromNativeInt]
from mypy_extensions import i64, i32, i16, u8, u64

def from_u64(x: u64) -> u64:
    return u64(x)

def from_u8(x: u8) -> u64:
    return u64(x)

def from_i16(x: i16) -> u64:
    return u64(x)

def from_i32(x: i32) -> u64:
    return u64(x)

def from_i64(x: i64) -> u64:
    return u64(x)
[out]
def from_u64(x):
    x :: u64
L0:
    return x
def from_u8(x):
    x :: u8
    r0 :: u64
L0:
    r0 = extend x: u8 to u64
    return r0
def from_i16(x):
    x :: i16
    r0 :: u64
L0:
    r0 = extend signed x: i16 to u64
    return r0
def from_i32(x):
    x :: i32
    r0 :: u64
L0:
    r0 = extend signed x: i32 to u64
    return r0
def from_i64(x):
    x :: i64
    r0 :: u64
L0:
    r0 = truncate x: i64 to u64
    return r0

[case testU64ExplicitConversionToNativeInt]
from mypy_extensions import i64, i32, i16, u8, u64

def to_u8(x: u64) -> u8:
