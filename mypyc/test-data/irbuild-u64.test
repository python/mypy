[out]
def to_u8(x):
    x :: u64
    r0 :: u8
L0:
    r0 = truncate x: u64 to u8
    return r0
def to_i16(x):
    x :: u64
    r0 :: i16
L0:
    r0 = truncate x: u64 to i16
    return r0
def to_i32(x):
    x :: u64
    r0 :: i32
L0:
    r0 = truncate x: u64 to i32
    return r0
def to_i64(x):
    x :: u64
    r0 :: i64
L0:
    r0 = truncate x: u64 to i64
    return r0

[case testU64ExplicitConversionFromInt_64bit]
from mypy_extensions import u64

def f(x: int) -> u64:
    return u64(x)
[out]
def f(x):
    x :: int
    r0 :: native_int
    r1, r2 :: bit
    r3, r4 :: u64
    r5 :: ptr
    r6 :: c_ptr
    r7 :: u64
L0:
    r0 = x & 1
    r1 = r0 == 0
    if r1 goto L1 else goto L3 :: bool
L1:
    r2 = x >= 0 :: signed
    if r2 goto L2 else goto L4 :: bool
L2:
    r3 = x >> 1
    r4 = r3
    goto L5
L3:
    r5 = x ^ 1
    r6 = r5
    r7 = CPyLong_AsUInt64(r6)
    r4 = r7
    keep_alive x
    goto L5
L4:
    CPyUInt64_Overflow()
    unreachable
L5:
    return r4

[case testU64ExplicitConversionFromInt_32bit]
from mypy_extensions import u64

def f(x: int) -> u64:
    return u64(x)
[out]
def f(x):
    x :: int
    r0 :: native_int
    r1, r2 :: bit
    r3, r4, r5 :: u64
    r6 :: ptr
    r7 :: c_ptr
    r8 :: u64
L0:
    r0 = x & 1
    r1 = r0 == 0
    if r1 goto L1 else goto L3 :: bool
L1:
    r2 = x >= 0 :: signed
    if r2 goto L2 else goto L4 :: bool
L2:
    r3 = extend signed x: builtins.int to u64
    r4 = r3 >> 1
    r5 = r4
    goto L5
L3:
    r6 = x ^ 1
    r7 = r6
    r8 = CPyLong_AsUInt64(r7)
    r5 = r8
    keep_alive x
    goto L5
L4:
    CPyUInt64_Overflow()
    unreachable
L5:
    return r5

[case testU64ExplicitConversionFromLiteral_64bit]
from mypy_extensions import u64

def f() -> None:
    x = u64(0)
    y = u64(11)
    z = u64(-3)  # Truncate
    zz = u64(4294967298)  # Truncate
    a = u64(18446744073709551615)
    b = u64(18446744073709551621)  # Truncate
    c = u64(-18446744073709551615)  # Truncate
[out]
def f():
    x, y, z, zz :: u64
    r0 :: int
    a :: u64
    r1 :: int
    b :: u64
    r2 :: int
    c :: u64
L0:
    x = 0
    y = 11
    z = 18446744073709551613
    zz = 4294967298
    r0 = object 18446744073709551615
    a = 18446744073709551615
    r1 = object 18446744073709551621
    b = 5
    r2 = object -18446744073709551615
    c = 1
    return 1

[case testU64FromShortInt_64bit]
from mypy_extensions import u64

def g(a: list[int]) -> u64:
    x: u64 = len(a)
    return x
[out]
def g(a):
    a :: list
    r0 :: native_int
    r1 :: short_int
    r2 :: bit
    r3, x :: u64
L0:
    r0 = var_object_size a
    r1 = r0 << 1
    r2 = r1 >= 0 :: signed
    if r2 goto L2 else goto L1 :: bool
L1:
    CPyUInt64_Overflow()
    unreachable
L2:
    r3 = r1 >> 1
    x = r3
    return x

[case testU64ListGetSetItem]
from typing import List
from mypy_extensions import u64

def get(a: List[int], i: u64) -> int:
    return a[i]

def set(a: List[int], i: u64, x: int) -> None:
    a[i] = x
[out]
def get(a, i):
    a :: list
    i :: u64
    r0 :: object
    r1 :: int
L0:
    r0 = CPyList_GetItemUInt64(a, i)
    r1 = unbox(int, r0)
    return r1
def set(a, i, x):
    a :: list
    i :: u64
    x :: int
    r0 :: object
    r1 :: bit
L0:
    r0 = box(int, x)
    r1 = CPyList_SetItemUInt64(a, i, r0)
    return 1

[case testListGetSetItemBoolIndexNotAmbiguous]
# Bool matches both the i64 and u64 index ops; the i64 op must win
from typing import List

class C:
    s: str

def get(a: List[int], b: bool) -> int:
    return a[b]

def get_borrow(a: List[C], b: bool) -> str:
    return a[b].s

def set(a: List[int], b: bool, x: int) -> None:
    a[b] = x
[out]
def get(a, b):
    a :: list
    b :: bool
    r0 :: i64
    r1 :: object
    r2 :: int
L0:
    r0 = extend b: builtins.bool to i64
    r1 = CPyList_GetItemInt64(a, r0)
    r2 = unbox(int, r1)
    return r2
def get_borrow(a, b):
    a :: list
    b :: bool
    r0 :: i64
    r1 :: object
    r2 :: __main__.C
    r3 :: str
L0:
    r0 = extend b: builtins.bool to i64
    r1 = CPyList_GetItemInt64Borrow(a, r0)
    r2 = borrow cast(__main__.C, r1)
    r3 = r2.s
    keep_alive a, r0, r1
    return r3
def set(a, b, x):
    a :: list
    b :: bool
    x :: int
    r0 :: i64
    r1 :: object
    r2 :: bit
L0:
    r0 = extend b: builtins.bool to i64
    r1 = box(int, x)
    r2 = CPyList_SetItemInt64(a, r0, r1)
    return 1
