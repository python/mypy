[case testTypeVarNarrowing]
from typing import TypeVar

class B:
    def __init__(self, x: int) -> None:
        self.x = x
class C(B):
    def __init__(self, x: int, y: str) -> None:
        self.x = x
        self.y = y

T = TypeVar("T", bound=B)
def f(x: T) -> T:
    if isinstance(x, C):
        print("C", x.y)
        return x
    print("B", x.x)
    return x

