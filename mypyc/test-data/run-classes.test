    i.__setattr__("sub_attr", 2)
    assert i.sub_attr == 2
    with assertRaises(AttributeError):
        i.__setattr__("class_var", "y")
    with assertRaises(AttributeError):
        i.__setattr__("subclass_var", "a")
    with assertRaises(AttributeError):
