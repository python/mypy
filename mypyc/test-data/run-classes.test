from native import (
    Base, Native, Leaf, Del, NativeDel, Open, OpenNative, co_base, co_native, events, s_open,
    s_open_native, test_native_method_overrides_decorated_method,
)

test_native_method_overrides_decorated_method()

assert Base().o() == "base"
assert Native().o() == 3
assert Base().s() == "s5"
assert Native().s() == "native"
assert Leaf().s() == "leaf"
assert Base().n() == 11
assert Native().n() == 2

assert asyncio.run(co_base(Base())) == 1
assert asyncio.run(co_base(Native())) == 2
assert asyncio.run(co_native(Native())) == 2

Del()
assert events == ["decorated", "Del"], events
events.clear()
NativeDel()
assert events == ["NativeDel"], events

