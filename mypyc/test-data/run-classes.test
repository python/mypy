[case testPickling]
from mypy_extensions import trait, mypyc_attr
from typing import Any, TypeVar, Generic

def dec(x: Any) -> Any:
    return x

@mypyc_attr(allow_interpreted_subclasses=True)
class A:
    x: int
    y: str

@mypyc_attr(allow_interpreted_subclasses=True)
class B(A):
    z: bool

    def __init__(self, x: int, y: str, z: bool) -> None:
        self.x = x
        self.y = y
        self.z = z

@trait
class T:
    a: str

class C(B, T):
    w: object

    # property shouldn't go in
    @property
    def foo(self) -> int:
        return 0

@dec
class D:
    x: int

class E(D):
    y: int


U = TypeVar('U')

class F(Generic[U]):
    y: int

class G(F[int]):
    pass

[file driver.py]
from native import A, B, T, C, D, E, F, G

import copy
import pickle

assert A.__mypyc_attrs__ == ('x', 'y')
assert B.__mypyc_attrs__ == ('z', 'x', 'y')
assert T.__mypyc_attrs__ == ('a',)
assert C.__mypyc_attrs__ == ('w', 'z', 'x', 'y', 'a')
assert not hasattr(D, '__mypyc_attrs__')
assert E.__mypyc_attrs__ == ('y', '__dict__')
assert F.__mypyc_attrs__ == ('y', '__dict__')
assert G.__mypyc_attrs__ == ('y', '__dict__')

b = B(10, '20', False)
assert b.__getstate__() == {'z': False, 'x': 10, 'y': '20'}
b2 = copy.copy(b)
assert b is not b2 and b.y == b2.y

b3 = pickle.loads(pickle.dumps(b))
assert b is not b3 and b.y == b3.y

e = E()
e.x = 10
e.y = 20

assert e.__getstate__() == {'y': 20, '__dict__': {'x': 10}}
e2 = pickle.loads(pickle.dumps(e))
assert e is not e2 and e.x == e2.x and e.y == e2.y

[case testPickleFrozenDataclass]
import copy
import pickle
from dataclasses import dataclass
from typing import Any, Dict, List

from mypy_extensions import mypyc_attr

@dataclass(frozen=True)
class Config:
    py_version: str = "3"

@dataclass(frozen=True)
class Frozen:
    x: int
    y: str

@dataclass(frozen=True)
class FrozenSub(Frozen):
    z: List[int]

@dataclass(frozen=True, slots=True)
class FrozenSlots:
    a: int
    b: Dict[int, int]

setattr_calls: List[str] = []

@mypyc_attr(serializable=True)
class WithSetattr:
    def __init__(self, x: int) -> None:
        self.x = x

    def __setattr__(self, name: str, value: object) -> None:
        setattr_calls.append(name)
        super().__setattr__(name, value)

def round_trips(obj: Any) -> List[Any]:
    # Protocols 0 and 1 can't rebuild any native class
    out = [pickle.loads(pickle.dumps(obj, protocol))
           for protocol in range(2, pickle.HIGHEST_PROTOCOL + 1)]
    return out + [copy.copy(obj), copy.deepcopy(obj)]

def test_frozen_dataclass() -> None:
    for obj in Config(), Frozen(1, 'a'), FrozenSub(2, 'b', [3]), FrozenSlots(4, {5: 6}):
        for copied in round_trips(obj):
            assert copied == obj
            assert copied is not obj
            assert type(copied) is type(obj)

def test_copy_is_still_frozen() -> None:
    f: Any = copy.copy(Frozen(1, 'a'))
    try:
        f.x = 2
    except AttributeError as e:
        assert type(e).__name__ == 'FrozenInstanceError'
    else:
        assert False
    assert f.x == 1

def test_setattr_not_called() -> None:
    # Python restores the state without calling __setattr__ too, by updating __dict__
    obj = WithSetattr(1)
    calls = len(setattr_calls)
    for copied in round_trips(obj):
        assert copied.x == 1
    assert len(setattr_calls) == calls


