[case testClassWithFinalDecoratorInheritedWithProperties]
from typing import final

class B:
    def a(self) -> int:
        return 2

    @property
    def b(self) -> int:
        return self.a() + 2

    @property
    def c(self) -> int:
        return 3

def test_class_final_attribute_basic() -> None:
    assert B().a() == 2
    assert B().b == 4
    assert B().c == 3

@final
class C(B):
    def a(self) -> int:
        return 1

    @property
    def b(self) -> int:
        return self.a() + 1

def fn(cl: B) -> int:
    return cl.a()

def test_class_final_attribute_inherited() -> None:
    assert C().a() == 1
    assert fn(C()) == 1
    assert B().a() == 2
    assert fn(B()) == 2

    assert B().b == 4
    assert C().b == 2
    assert B().c == 3
    assert C().c == 3

