[case testPropertyReturningCallable]
from typing import Any, Callable
from mypy_extensions import trait

class Config:
    def __init__(self) -> None:
        self._sorting_function: Callable[..., list[str]] | None = None

    @property
    def sorting_function(self) -> Callable[..., list[str]]:
        if self._sorting_function is not None:
            return self._sorting_function
        self._sorting_function = sorted
        return self._sorting_function

    def sort(self, items: list[str]) -> list[str]:
        return self.sorting_function(items)

class Item:
    def __init__(self, n: int) -> None:
        self.n = n

class C:
    @property
    def no_args(self) -> Callable[[], str]:
        return lambda: "called"

    @property
    def any_value(self) -> Any:
        return lambda x: x * 2

    @property
    def item_type(self) -> type[Item]:
        return Item

class Base:
    @property
    def f(self) -> Callable[[int], int]:
        return lambda x: x + 1

class Derived(Base):
    def call_super(self, x: int) -> int:
        return super().f(x)

class AttrOverride(Base):
    # A builtin, so that it isn't bound as a method when interpreted
    f: Callable[[int], int] = abs

@trait
class T:
    @property
    def f(self) -> Callable[[int], int]:
        return lambda x: x - 1

class UsesTrait(T):
    pass

def call_f(b: Base, x: int) -> int:
    return b.f(x)

def call_trait_f(t: T, x: int) -> int:
    return t.f(x)

def test_property_returning_callable() -> None:
    config = Config()
    assert config.sorting_function(["b2", "b10", "b1"]) == ["b1", "b10", "b2"]
    assert config.sorting_function(["a", "b"], reverse=True) == ["b", "a"]
    assert config.sort(["b", "a"]) == ["a", "b"]

def test_property_returning_other_callables() -> None:
    c = C()
    assert c.no_args() == "called"
    assert c.any_value(21) == 42
    assert c.item_type(5).n == 5

def test_property_returning_callable_inherited() -> None:
    assert call_f(Base(), 1) == 2
    assert call_f(Derived(), 1) == 2
    assert Derived().call_super(2) == 3
    assert call_f(AttrOverride(), -5) == 5
    assert AttrOverride().f(-6) == 6
    assert call_trait_f(UsesTrait(), 1) == 0

[case testPropertyWithOtherDecorator]
from functools import cache, cached_property
from typing import Any, Callable

from mypy_extensions import mypyc_attr, trait
from testutil import assertRaises

def double(f: Callable[[Any], int]) -> Callable[[Any], int]:
    def wrapper(self: Any) -> int:
        return f(self) * 2

    return wrapper

def to_str(f: Callable[[Any], int]) -> Callable[[Any], str]:
    def wrapper(self: Any) -> str:
        return f"<{f(self)}>"

    return wrapper

class C:
    def __init__(self) -> None:
        self.calls = 0

    @property
    @double
    def p(self) -> int:
        self.calls += 1
        return 21

    @property
    @to_str
    def s(self) -> int:
        return 5

    @property
    @to_str
    @double
    def two(self) -> int:
        return 3

    @property
    @cache
    def cached(self) -> int:
        self.calls += 1
        return 7

    @cached_property
    @double
    def cp(self) -> int:
        return 4

    def via_self(self) -> int:
        return self.p + 1

class Base:
    @property
    @double
    def x(self) -> int:
        return 1

class NativeOverride(Base):
    @property
    def x(self) -> int:
        return 5

class DecoratedOverride(Base):
    @property
    @double
    def x(self) -> int:
        return 10

class AttrOverride(Base):
    x: int = 7

@trait
class T:
    @property
    @double
    def t(self) -> int:
        return 4

class UsesTrait(T):
    pass

@mypyc_attr(allow_interpreted_subclasses=True)
class Open:
    @property
    @double
    def o(self) -> int:
        return 8

@mypyc_attr(native_class=False)
class NonNative:
    def __init__(self) -> None:
        self.calls = 0

    @property
    @double
    def p(self) -> int:
        self.calls += 1
        return 3

    @property
    @to_str
    def s(self) -> int:
        return 5

    @property
    @cache
    def cached(self) -> int:
        self.calls += 1
        return 7

def get_x(b: Base) -> int:
    return b.x

def get_t(t: T) -> int:
    return t.t

def get_o(o: Open) -> int:
    return o.o

def test_property_with_other_decorator() -> None:
    c = C()
    assert c.p == 42
    assert c.p + 1 == 43
    assert c.calls == 2
    assert c.via_self() == 43
    assert c.s == "<5>"
    assert c.two == "<6>"
    a: Any = c
    assert a.p == 42
    assert a.s == "<5>"
    assert isinstance(getattr(C, "p"), property)
    with assertRaises(AttributeError):
        a.p = 1

def test_property_with_caching_decorator() -> None:
    c = C()
    assert c.cached == 7
    assert c.cached == 7
    assert c.calls == 1
    assert C().cached == 7
    assert c.cp == 8

def test_property_with_other_decorator_inherited() -> None:
    assert get_x(Base()) == 2
    assert get_x(NativeOverride()) == 5
    assert NativeOverride().x == 5
    assert get_x(DecoratedOverride()) == 20
    assert DecoratedOverride().x == 20
    assert get_x(AttrOverride()) == 7
    assert AttrOverride().x == 7
    assert get_t(UsesTrait()) == 8
    assert UsesTrait().t == 8

def test_property_with_other_decorator_interpreted_subclass() -> None:
    assert get_o(Open()) == 16
    make_type: Any = type
    sub = make_type("Sub", (Open,), {"o": 3})
    assert get_o(sub()) == 3

def test_property_with_other_decorator_non_native() -> None:
    n = NonNative()
    assert n.p == 6
    assert n.calls == 1
    assert n.s == "<5>"
    assert n.cached == 7
    assert n.cached == 7
    assert n.calls == 2
    a: Any = n
    assert a.p == 6
    assert isinstance(getattr(NonNative, "p"), property)
    with assertRaises(AttributeError):
        a.p = 1

[case testPropertySetters]

from mypy_extensions import trait

class Foo():
    def __init__(self) -> None:
        self.attr = "unmodified"

class A:
    def __init__(self) -> None:
        self._x = 0
        self._foo = Foo()

    @property
    def x(self) -> int:
        return self._x

    @x.setter
    def x(self, val : int) -> None:
        self._x = val

    @property
    def foo(self) -> Foo:
        return self._foo

    @foo.setter
    def foo(self, val : Foo) -> None:
        self._foo = val

# Overrides base property setters and getters
class B(A):
    def __init__(self) -> None:
        self._x = 10

    @property
    def x(self) -> int:
        return self._x + 1

    @x.setter
    def x(self, val : int) -> None:
        self._x = val + 1

# Inherits base property setters and getters
class C(A):
    def __init__(self) -> None:
        A.__init__(self)

@trait
class D():
    def __init__(self) -> None:
        self._x = 0

    @property
    def x(self) -> int:
        return self._x

    @x.setter
    def x(self, val : int) -> None:
        self._x = val

#Inherits trait property setters and getters
class E(D):
    def __init__(self) -> None:
        D.__init__(self)

#Overrides trait property setters and getters
class F(D):
    def __init__(self) -> None:
        self._x = 10

    @property
    def x(self) -> int:
        return self._x + 10

    @x.setter
    def x(self, val : int) -> None:
        self._x = val + 10

# # Property setter and getter are subtypes of base property setters and getters
# # class G(A):
# #   def __init__(self) -> None:
# #       A.__init__(self)

# #   @property
# #   def y(self) -> int:
# #       return self._y

# #   @y.setter
# #   def y(self, val : object) -> None:
# #       self._y = val

# No inheritance, just plain setter/getter
class G:
    def __init__(self, x: int) -> None:
        self._x = x

    @property
    def x(self) -> int:
        return self._x

    @x.setter
    def x(self, x: int) -> None:
        self._x = x

class H:
    def __init__(self, g: G) -> None:
        self.g = g
        self.g.x = 5  # Should not be treated as initialization

[file other.py]
# Run in both interpreted and compiled mode
import gc

from native import A, B, C, D, E, F, Foo, G

def test_leaks() -> None:
    a = A()

    gc.collect()
    before = gc.get_objects()
    for _ in range(100):
        a.foo = Foo()
    gc.collect()
    after = gc.get_objects()

    diff = len(after) - len(before)
    # Small difference is expected, if the property setter call was leaking objects
    # we would get a difference similar to the number of iterations above.
    assert diff <= 2, diff

def set_foo(foo: Foo) -> None:
    a = A()
    a.foo = foo

def test_use_after_passing_to_prop_setter() -> None:
    foo = Foo()

    foo.attr = "before"
    assert foo.attr == "before", foo.attr

    set_foo(foo)
    assert foo.attr == "before", foo.attr

    foo.attr = "after"
    assert foo.attr == "after", foo.attr

a = A()
assert a.x == 0
assert a._x == 0
a.x = 1
assert a.x == 1
assert a._x == 1
a._x = 0
assert a.x == 0
assert a._x == 0
b = B()
assert b.x == 11
assert b._x == 10
b.x = 11
assert b.x == 13
b._x = 11
assert b.x == 12
c = C()
assert c.x == 0
c.x = 1000
assert c.x == 1000
e = E()
assert e.x == 0
e.x = 1000
assert e.x == 1000
f = F()
assert f.x == 20
f.x = 30
assert f.x == 50
g = G(4)
g.x = 20
assert g.x == 20

test_leaks()
test_use_after_passing_to_prop_setter()

