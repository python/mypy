[case testDecoratedDunderNewWithOtherArgumentsThanInit]
from __future__ import annotations

import functools
from typing import Any, Callable, TypeVar

from typing_extensions import Self

F = TypeVar("F", bound=Callable[..., Any])

log: list[str] = []

def take() -> list[str]:
    result = list(log)
    log.clear()
    return result

def logged(f: F) -> F:
    def wrapper(cls: Any, *args: Any, **kwargs: Any) -> Any:
        log.append(f"before {cls.__name__} {args} {kwargs}")
        obj = f(cls, *args, **kwargs)
        log.append("after")
        return obj
    return wrapper  # type: ignore[return-value]

class NoInit:
    x: int

    @logged
    def __new__(cls, x: int) -> Self:
        obj = super().__new__(cls)
        obj.x = x + 1
        return obj

def test_no_init() -> None:
    n = NoInit(1)
    assert take() == ["before NoInit (1,) {}", "after"]
    assert n.x == 2
    cls: Any = NoInit
    n = cls(x=2)
    assert take() == ["before NoInit () {'x': 2}", "after"]
    assert n.x == 3

class AnyArguments:
    @logged
    def __new__(cls, *args: Any, **kwargs: Any) -> Self:
        log.append("new")
        return super().__new__(cls)

    def __init__(self, x: int, y: int = 0) -> None:
        log.append(f"init {x} {y}")
        self.x = x
        self.y = y

class AnyArgumentsChild(AnyArguments):
    def __init__(self, x: int) -> None:
        super().__init__(x, 10)

def test_any_arguments() -> None:
    a = AnyArguments(1, y=2)
    assert take() == ["before AnyArguments (1,) {'y': 2}", "new", "after", "init 1 2"]
    assert (a.x, a.y) == (1, 2)
    c = AnyArgumentsChild(3)
    assert take() == ["before AnyArgumentsChild (3,) {}", "new", "after", "init 3 10"]
    assert (c.x, c.y) == (3, 10)
    cls: Any = AnyArguments
    a = cls(4)
    assert take() == ["before AnyArguments (4,) {}", "new", "after", "init 4 0"]
    assert (a.x, a.y) == (4, 0)

class Interned:
    name: str

    @functools.cache  # type: ignore[misc]
    def __new__(cls, name: str) -> Self:
        log.append(f"new {name}")
        obj = super().__new__(cls)
        obj.name = name
        return obj

def test_cache() -> None:
    a = Interned("a")
    b = Interned("b")
    assert Interned("a") is a
    cls: Any = Interned
    assert cls("b") is b
    assert take() == ["new a", "new b"]
    assert (a.name, b.name) == ("a", "b")
    assert cls.__new__.cache_info().hits == 2

