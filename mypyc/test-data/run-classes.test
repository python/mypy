        return "interp open"

assert s_open(Interp()) == "interp"
assert s_open_native(Interp()) == "interp"
assert s_open(InterpInherits()) == "open"
assert s_open_native(InterpInherits()) == "open"
assert s_open(InterpOpen()) == "interp open"

[case testNativePropertyOverridesDecoratedProperty]
from typing import Any, Callable
from mypy_extensions import trait

def to_str(f: Callable[[Any], int]) -> Callable[[Any], str]:
    def wrapper(self: Any) -> str:
        return "s" + str(f(self))
    return wrapper

class Base:
    @property
    @to_str
    def p(self) -> int:
        return 5

class Native(Base):
    @property
    def p(self) -> str:
        return "native"

class Leaf(Native):
    @property
    def p(self) -> str:
        return "leaf"

@trait
class Trait:
    @property
    @to_str
    def p(self) -> int:
        return 7

class Impl(Trait):
    @property
    def p(self) -> str:
        return "impl"

class Uses(Trait):
    pass

def p_base(b: Base) -> str:
    return b.p

def p_native(b: Native) -> str:
    return b.p

def p_trait(t: Trait) -> str:
    return t.p

def p_impl(i: Impl) -> str:
    return i.p

def test_native_property_overrides_decorated_property() -> None:
    assert p_base(Base()) == "s5"
    assert p_base(Native()) == "native"
    assert p_base(Leaf()) == "leaf"
    assert p_native(Native()) == "native"
    assert p_native(Leaf()) == "leaf"
    assert p_trait(Impl()) == "impl"
    assert p_trait(Uses()) == "s7"
    assert p_impl(Impl()) == "impl"

