[case testSubclassUnsupportedException]
from mypy_extensions import mypyc_attr

@mypyc_attr(native_class=False)
class MyError(ZeroDivisionError):
    pass

@mypyc_attr(native_class=False)
class MyError2(ZeroDivisionError):
    def __init__(self, s: str) -> None:
        super().__init__(s + "!")
        self.x = s.upper()

def f() -> None:
    raise MyError("foobar")

def test_non_native_exception_subclass_basics() -> None:
    e = MyError()
    assert isinstance(e, MyError)
    assert isinstance(e, ZeroDivisionError)
    assert isinstance(e, Exception)

    e = MyError("x")
    assert repr(e) == "MyError('x')"

    e2 = MyError2("ab")
    assert repr(e2) == "MyError2('ab!')", repr(e2)
    assert e2.x == "AB"

def test_raise_non_native_exception_subclass_1() -> None:
    try:
        f()
    except MyError:
        x = True
    else:
        assert False
    assert x

def test_raise_non_native_exception_subclass_2() -> None:
    try:
        f()
    except ZeroDivisionError:
        x = True
    else:
        assert False
    assert x

[case testSubclassUnknownPythonBase]
# The base class is unknown during compilation, so it has type Any
from mypy_extensions import mypyc_attr
from typing import Any, Generic, TypeVar
from unchecked import Base, MetaBase, SecondBase, StrBase  # type: ignore

T = TypeVar("T")

@mypyc_attr(native_class=False)
class C(Base):
    def __init__(self, x: int) -> None:
        super().__init__()
        self.x = x

    def marker(self) -> str:
        return "override " + super().marker()

@mypyc_attr(native_class=False)
class InheritedInit(Base):
    pass

@mypyc_attr(native_class=False)
class D(InheritedInit):
    pass

@mypyc_attr(native_class=False)
class S(StrBase):
    pass

@mypyc_attr(native_class=False)
class WithMeta(MetaBase):
    pass

@mypyc_attr(native_class=False)
class Known:
    def marker(self) -> str:
        return "known"

@mypyc_attr(native_class=False)
class KnownFirst(Known, Base):
    pass

@mypyc_attr(native_class=False)
class UnknownFirst(Base, Known):
    pass

@mypyc_attr(native_class=False)
class TwoUnknown(Base, SecondBase):
    pass

@mypyc_attr(native_class=False)
class GenericLast(Base, Generic[T]):
    pass

@mypyc_attr(native_class=False)
class GenericFirst(Generic[T], Base):
    pass

@mypyc_attr(native_class=False)
class KnownGeneric(Generic[T]):
    pass

@mypyc_attr(native_class=False)
class KnownGenericBase(Base, KnownGeneric[int]):
    pass

def test_unknown_base() -> None:
    c = C(1)
    assert c.x == 1
    assert c.y == 2
    assert c.label == "base attribute"
    assert c.marker() == "override base"
    c.z = 3
    assert c.z == 3
    assert c.__dict__ == {"x": 1, "y": 2, "z": 3}
    assert isinstance(c, Base)

def test_inherited_init() -> None:
    assert InheritedInit().y == 2
    assert InheritedInit(7).y == 7
    assert InheritedInit(x=11).y == 11
    d = D(13)
    assert d.y == 13
    assert d.label == "base attribute"
    assert d.marker() == "base"
    assert D(x=17).y == 17
    try:
        InheritedInit(-1)
    except ValueError as e:
        assert str(e) == "negative"
    else:
        assert False

def test_unknown_extension_base() -> None:
    assert S.__basicsize__ >= StrBase.__basicsize__
    c = S("abc")
    assert isinstance(c, str)
    assert c == "abc"
    assert len(c) == 3
    assert c.upper() == "ABC"

def test_unknown_base_metaclass() -> None:
    assert isinstance(WithMeta, type(MetaBase))
    assert isinstance(WithMeta(), MetaBase)

def test_multiple_inheritance() -> None:
    assert KnownFirst.__bases__ == (Known, Base)
    assert UnknownFirst.__bases__ == (Base, Known)
    assert TwoUnknown.__bases__ == (Base, SecondBase)
    assert KnownFirst(3).y == 3
    assert UnknownFirst(x=5).y == 5
    assert KnownFirst().marker() == "known"
    assert UnknownFirst().marker() == "base"
    assert TwoUnknown(7).y == 7
    assert TwoUnknown().other() == "second"

def test_generic_bases() -> None:
    generic: Any = globals()["Generic"]
    type_var: Any = globals()["T"]
    assert GenericLast.__bases__ == (Base, generic)
    assert GenericFirst.__bases__ == (generic, Base)
    assert GenericLast.__orig_bases__ == (Base, generic[type_var])
    assert GenericFirst.__orig_bases__ == (generic[type_var], Base)
    assert GenericLast.__parameters__ == (type_var,)
    assert GenericFirst.__parameters__ == (type_var,)
    assert GenericLast[int](3).y == 3
    assert GenericFirst[str](5).y == 5
    assert KnownGenericBase.__bases__ == (Base, KnownGeneric)
    assert KnownGenericBase.__orig_bases__ == (Base, KnownGeneric[int])
    assert KnownGenericBase(7).y == 7

