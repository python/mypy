[case testMatchOrSequencePattern_python3_10]
def f(x: tuple[str, str]) -> str:
    match x:
        case ("X", "Y") | ("X", "Z"):
            return "THERE"
        case _:
            return "OTHER"

[file driver.py]
from native import f

print(f(("X", "Y")))
print(f(("X", "Z")))
print(f(("X", "A")))

[out]
THERE
THERE
OTHER

[case testCustomMappingAndSequenceObjects_python3_10]
def f(x: object) -> None:
    match x:
        case {"key": "value", **rest}:
            print(rest, type(rest))

        case [1, 2, *rest2]:
            print(rest2, type(rest2))

[file driver.py]
from collections.abc import Mapping, Sequence

from native import f

class CustomMapping(Mapping):
    inner: dict

    def __init__(self, inner: dict) -> None:
        self.inner = inner

    def __getitem__(self, key):
        return self.inner[key]

    def __iter__(self):
        return iter(self.inner)

    def __len__(self) -> int:
        return len(self.inner)


class CustomSequence(Sequence):
    inner: list

    def __init__(self, inner: list) -> None:
        self.inner = inner

    def __getitem__(self, index: int) -> None:
        return self.inner[index]

    def __len__(self) -> int:
        return len(self.inner)

mapping = CustomMapping({"key": "value", "some": "data"})
sequence = CustomSequence([1, 2, 3])

f(mapping)
f(sequence)

[out]
{'some': 'data'} <class 'dict'>
[3] <class 'list'>

[case testSequencePatternGetItemRaises_python3_10]
def f(x: object) -> object:
    match x:
        case [a, b]:
            return a
    return None

def g(x: object) -> object:
    match x:
        case [1, *rest, b]:
            return b
    return None

[file driver.py]
from collections.abc import Sequence

from native import f, g

class BadSequence(Sequence):
    def __len__(self) -> int:
        return 2

    def __getitem__(self, index: int) -> None:
        raise RuntimeError("boom")

for fn in (f, g):
    try:
        fn(BadSequence())
    except RuntimeError as e:
        print(type(e).__name__, e)

[out]
RuntimeError boom
RuntimeError boom

[case testMatchAsPatternBindsSubject_python3_10]
from typing import Any

def seq(x: Any) -> object:
    match x:
        case [a, b] as z:
            return z
    return None

def mapping(x: Any) -> object:
    match x:
        case {"k": a} as z:
            return z
    return None

def nested(x: Any) -> object:
    match x:
        case [(1 as a), *_] as z:
            return (a, z)
    return None

def value(x: Any) -> object:
    match x:
        case 1.0 as z:
            return z
    return None

def or_pattern(x: Any) -> object:
    match x:
        case ([1, _] | {"k": 1} | None | 5) as z:
            return ("or", z)
    return None

[file driver.py]
from native import seq, mapping, nested, value, or_pattern

assert seq([1, 2]) == [1, 2]
assert seq((3, 4)) == (3, 4)
assert seq([1]) is None
assert mapping({"k": 1}) == {"k": 1}
assert mapping({}) is None
assert nested([1, 2]) == (1, [1, 2])
assert nested([2, 2]) is None
assert type(value(1)) is int
assert value(True) is True
assert type(value(1.0)) is float
assert value(2) is None
assert or_pattern([1, 9]) == ("or", [1, 9])
assert or_pattern({"k": 1}) == ("or", {"k": 1})
assert or_pattern(None) == ("or", None)
assert type(or_pattern(5.0)[1]) is float
assert or_pattern([2, 2]) is None
