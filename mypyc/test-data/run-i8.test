[case testI8BasicOps]
from typing import Any, Final

from mypy_extensions import i8, i16, i32, i64, u8, u16, u32, u64
from testutil import assertRaises

def div(x: i8, y: i8) -> i8:
    return x // y

def mod(x: i8, y: i8) -> i8:
    return x % y

def to_i8(x: i16) -> i8:
    return i8(x)

def widen(x: i8) -> tuple[i16, i32, i64]:
    return i16(x), i32(x), i64(x)

def from_u8(x: u8) -> i8:
    return i8(x)

def to_unsigned(x: i8) -> tuple[u8, u16, u32, u64]:
    return u8(x), u16(x), u32(x), u64(x)

def test_box_unbox_and_divmod() -> None:
    for value in range(-128, 128):
        o: Any = value
        x: i8 = o
        assert x == value
    for value in (-129, 128):
        with assertRaises(ValueError, "int too large to convert to i8"):
            o = value
            x = o
    for x in range(-128, 128):
        for y in range(-128, 128):
            if y == 0:
                with assertRaises(ZeroDivisionError):
                    div(x, y)
                    mod(x, y)
            elif x == -128 and y == -1:
                with assertRaises(OverflowError, "integer division overflow"):
                    div(x, y)
                assert mod(x, y) == 0
            else:
                assert div(x, y) == x // y
                assert mod(x, y) == x % y

def test_operations() -> None:
    x: i8 = 65 + int()
    y: i8 = -12 + int()
    assert x + y == 53
    assert x * y == -12
    assert x << 1 == -126
    assert y >> 2 == -3
    assert ~x == -66
    assert abs(x) == 65
    assert abs(y) == 12

def test_left_shift_wraps_around() -> None:
    max_i8: i8 = 2**7 - 1 + int()
    min_i8: i8 = -2**7 + int()
    one: i8 = 1 + int()
    assert max_i8 << one == -2
    assert min_i8 << one == 0
    assert -one << (one * 7) == min_i8

def test_shift_count_out_of_range() -> None:
    one: i8 = 1 + int()
    neg: i8 = -5 + int()
    width: i8 = 8 + int()
    for n in [width, -one, -width]:
        assert one << n == 0
        assert one >> n == 0
        assert neg >> n == -1
    # The largest valid count
    assert one << (width - one) == -2**7
    assert neg >> (width - one) == -1

MAX_I8_FINAL: Final[i8] = 127
MIN_I8_FINAL: Final[i8] = -MAX_I8_FINAL - 1

def test_arithmetic_wraps_around() -> None:
    max_i8: i8 = 127 + int()
    min_i8: i8 = -128 + int()
    one: i8 = 1 + int()
    two: i8 = 2 + int()
    assert max_i8 + one == min_i8
    assert min_i8 - one == max_i8
    assert max_i8 * two == -2
    assert max_i8 * max_i8 == 1
    assert min_i8 * -one == min_i8
    assert -min_i8 == min_i8
    assert max_i8 << one == -2
    assert one << (two * 3 + one) == min_i8
    x = max_i8
    x += one
    assert x == min_i8
    assert abs(min_i8) == min_i8
    assert abs(-max_i8) == max_i8
    assert abs(min_i8 + one) == max_i8
    assert -i8(-128) == min_i8
    assert MAX_I8_FINAL + 1 == min_i8
    assert MIN_I8_FINAL - 1 == max_i8
    assert -MIN_I8_FINAL == min_i8
    assert MAX_I8_FINAL * 2 == -2

def test_conversions() -> None:
    assert to_i8(127) == 127
    assert to_i8(128) == -128
    assert widen(-128) == (-128, -128, -128)
    assert from_u8(255) == -1
    assert to_unsigned(5) == (5, 5, 5, 5)
    assert to_unsigned(-1) == (255, 2**16 - 1, 2**32 - 1, 2**64 - 1)
    assert to_unsigned(-128) == (128, 2**16 - 128, 2**32 - 128, 2**64 - 128)

[case testI8FloorDivideConstantMinByMinusOne]
from typing import Final
from mypy_extensions import i8
from testutil import assertRaises

MIN: Final[i8] = -2**7
MINUS_ONE: Final[i8] = -1

def div() -> i8:
    return MIN // -1

def div_final() -> i8:
    return MIN // MINUS_ONE

def div_nested() -> i8:
    return MIN // -1 + 1

def mod() -> i8:
    return MIN % -1

def test_min_divided_by_minus_one() -> None:
    with assertRaises(OverflowError, "integer division overflow"):
        div()
    with assertRaises(OverflowError, "integer division overflow"):
        div_final()
    with assertRaises(OverflowError, "integer division overflow"):
        div_nested()
    assert mod() == 0
    assert MIN // 1 == MIN
